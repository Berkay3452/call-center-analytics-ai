# Mock (sahte) veri: true yapınca yerel mock kullanılır, varsayılan olarak gerçek API'ye bağlanır.
NEXT_PUBLIC_USE_MOCKS=false

# AI servisi (yalnızca sunucu tarafı; tarayıcıya verilmez).
API_URL=http://localhost:8000/api/v1
SERVICE_KEY=change-me-in-local-env

# İmzalı X-User-Id (#266): backend USER_SIGNING_KEY ile aynı değer (yalnızca sunucu tarafı).
USER_SIGNING_KEY=
# Yalnızca yerel geliştirme: tarayıcının x-user-id'sini imzalayıp iletir. Canlıda KAPALI olmalı;
# NODE_ENV=production iken APP_ENV local/test değilse bayrak true olsa bile reddedilir.
APP_ENV=local
ALLOW_BROWSER_USER_ID=true
