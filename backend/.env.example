# Bu dosyayı `.env` olarak kopyalayın ve değerleri doldurun. `.env` asla commit edilmez.

# --- Genel ---
APP_ENV=local
LOG_LEVEL=INFO
LOG_JSON=false
CORS_ORIGINS=http://localhost:3000

# --- Veritabanı ---
# Yerel geliştirme: infra/docker-compose.yml içindeki Postgres (port 5433).
# Supabase'e geçince Supabase panelindeki bağlantı adresi (postgresql+asyncpg://...) yazılır.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/call_center
DB_STATEMENT_CACHE_SIZE=0

# --- Redis / Celery ---
REDIS_URL=redis://localhost:6379/0

# --- Supabase Auth / Storage ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
STORAGE_BUCKET=call-audio
# Yalnızca yerel geliştirme: Supabase kurulmadan /api/v1 uçlarını denemek için true yapın.
AUTH_DEV_BYPASS=false

# --- LLM (ücretsiz, OpenAI-uyumlu sağlayıcılar: groq | openrouter | gemini | nvidia | ollama | openai_compatible) ---
# Geçici seçim (#13): Gemini (Google AI Studio ücretsiz anahtar); canlıdaki Vertex AI/Gemini'ye en yakın.
# Karşılaştırma ve gerekçe issue #13'te. Model değişirse burayı ve issue'yu güncelleyin.
LLM_PROVIDER=gemini
LLM_BASE_URL=
LLM_API_KEY=
# Sağlayıcının güncel ücretsiz model adlarını yazın (sağlayıcı panelinden kontrol edin).
LLM_FAST_MODEL=gemini-3.5-flash-lite
LLM_SMART_MODEL=gemini-3.5-flash
# Agent bazında model (isteğe bağlı). Boş bırakılırsa agent'ın katmanındaki model kullanılır:
#   fast  -> Çağrı Sınıflandırma, Özetleme
#   smart -> CRM Bilgi Çıkarım, Satış Analiz
# Bir agent'ın modelini değiştirmek için yalnızca ilgili satırı doldurup uygulamayı yeniden başlatın.
LLM_CALL_CLASSIFIER_MODEL=
LLM_CRM_EXTRACTION_MODEL=
LLM_SALES_ANALYZER_MODEL=
LLM_SUMMARIZER_MODEL=
LLM_MAX_CONCURRENCY=2
# Model başına dakikadaki en fazla istek (0 = sınırsız). Gemini ücretsiz katmanı model başına 5 kabul ediyor.
LLM_REQUESTS_PER_MINUTE=5

# --- STT ---
STT_PROVIDER=faster_whisper
WHISPER_MODEL=small
WHISPER_COMPUTE_TYPE=int8
HF_TOKEN=

# --- RAG / Embedding ---
EMBEDDING_PROVIDER=tei
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024
TEI_URL=http://localhost:8080
