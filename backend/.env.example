# Bu dosyayı `.env` olarak kopyalayın ve değerleri doldurun. `.env` asla commit edilmez.

# --- Genel ---
APP_ENV=local
LOG_LEVEL=INFO
LOG_JSON=false
CORS_ORIGINS=http://localhost:3000

# --- Veritabanı ---
# Yerel geliştirme: infra/docker-compose.yml içindeki Postgres (port 5433).
# Supabase'e geçince Supabase panelindeki bağlantı adresi (postgresql+asyncpg://...) yazılır.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/call_center
DB_STATEMENT_CACHE_SIZE=0

# --- Redis / Celery ---
REDIS_URL=redis://localhost:6379/0
# Takılı kalan çağrı zaman aşımı (dakika, varsayılan 10).
STUCK_CALL_TIMEOUT_MIN=10

# --- Servis Anahtarı / Supabase Storage ---
# .NET API'nin Python servisini çağırırken `X-Service-Key` başlığıyla gönderdiği paylaşılan anahtar.
SERVICE_API_KEY=change-me-in-local-env
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
STORAGE_BUCKET=call-audio
# Yalnızca yerel geliştirme: servis anahtarı kurulmadan /api/v1 uçlarını denemek için true yapın.
AUTH_DEV_BYPASS=false

# --- LLM (ücretsiz, OpenAI-uyumlu sağlayıcılar: groq | openrouter | gemini | nvidia | ollama | openai_compatible) ---
# Seçim: NVIDIA (build.nvidia.com, ücretsiz anahtar; Nemotron 3 ailesi). Anahtarı
# build.nvidia.com > API Keys'ten alın ve yalnızca kendi `.env` dosyanıza yazın (`nvapi-...`).
# Gemini yedek seçenektir: LLM_PROVIDER=gemini ve Gemini model adları (bkz. issue #13).
LLM_PROVIDER=nvidia
LLM_BASE_URL=
LLM_API_KEY=
# Sağlayıcının güncel model adlarını yazın: https://integrate.api.nvidia.com/v1/models
LLM_FAST_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
LLM_SMART_MODEL=nvidia/nemotron-3-super-120b-a12b
# Agent bazında model (isteğe bağlı). Boş bırakılırsa agent'ın katmanındaki model kullanılır:
#   fast  -> Çağrı Sınıflandırma, Özetleme
#   smart -> CRM Bilgi Çıkarım, Satış Analiz
# Bir agent'ın modelini değiştirmek için yalnızca ilgili satırı doldurup uygulamayı yeniden başlatın.
LLM_CALL_CLASSIFIER_MODEL=
LLM_CRM_EXTRACTION_MODEL=
LLM_SALES_ANALYZER_MODEL=
LLM_SUMMARIZER_MODEL=
LLM_MAX_CONCURRENCY=2
# Dayanıklılık: istek başına zaman aşımı (sn), istemci içi yeniden deneme, ajan başına toplam süre
# bütçesi (sn). Yavaş/ölü model ajanı dakikalarca bekletmesin.
LLM_TIMEOUT_S=30
LLM_MAX_RETRIES=1
LLM_AGENT_TIMEOUT_S=90
# Geçici hatada (zaman aşımı, 429, 5xx) bir kez denenecek yedek model. Boşsa öteki katmanın modeli
# (hızlı <-> güçlü) otomatik yedek olur.
LLM_FALLBACK_MODEL=
# NVIDIA Nemotron için true: modelin "düşünme" çıktısını kapatır (hız ve JSON uyumu için önerilir).
LLM_DISABLE_THINKING=true
# Model başına dakikadaki en fazla istek (0 = sınırsız). NVIDIA ücretsiz katman ~40/dk; güvenli pay 30.
# Gemini ücretsiz katmanı için 5 yazın.
LLM_REQUESTS_PER_MINUTE=30

# --- STT --- (faster_whisper | openai_compatible | stub)
STT_PROVIDER=faster_whisper
STT_LANGUAGE=tr
# mono | stereo_rep_left | stereo_rep_right (santral kaydında temsilcinin kanalı)
STT_CHANNEL_LAYOUT=mono
WHISPER_MODEL=small
WHISPER_COMPUTE_TYPE=int8
WHISPER_CPU_THREADS=0
# Modelin indirileceği klasör (boşsa C: diskinde ~/.cache/huggingface). Örn: D:/apps/ai-models/whisper
WHISPER_DOWNLOAD_ROOT=
# openai_compatible (ör. Groq Whisper) için:
STT_API_BASE_URL=https://api.groq.com/openai/v1
STT_API_KEY=
STT_API_MODEL=whisper-large-v3

# --- RAG / Embedding ---
# tei (bge-m3, Docker: docker compose -f infra/docker-compose.yml --profile rag up -d) | openai_compatible | hash
EMBEDDING_PROVIDER=tei
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024
TEI_URL=http://localhost:8080
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
